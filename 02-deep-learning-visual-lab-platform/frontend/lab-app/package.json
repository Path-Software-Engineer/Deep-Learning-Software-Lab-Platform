{
  "name": "@deep-learning-lab/visual-lab-platform",
  "version": "1.0.0",
  "private": true,
  "packageManager": "npm@11.12.1",
  "engines": {
    "node": ">=20.9.0"
  },
  "scripts": {
    "dev": "next dev",
    "build": "next build",
    "start": "next start",
    "lint": "eslint . --max-warnings=0",
    "typecheck": "tsc --noEmit",
    "test": "node --require ./tests/vite-windows-safe-realpath.cjs ./node_modules/vitest/vitest.mjs run --config vitest.config.mjs --configLoader runner --pool=threads --no-file-parallelism",
    "test:watch": "node --require ./tests/vite-windows-safe-realpath.cjs ./node_modules/vitest/vitest.mjs --config vitest.config.mjs --configLoader runner --pool=threads",
    "test:e2e": "playwright test",
    "check": "npm run lint && npm run typecheck && npm run test && npm run build"
  },
  "dependencies": {
    "next": "16.2.9",
    "react": "19.2.4",
    "react-dom": "19.2.4"
  },
  "devDependencies": {
    "@playwright/test": "1.58.2",
    "@testing-library/jest-dom": "6.9.1",
    "@testing-library/react": "16.3.2",
    "@types/node": "24.10.1",
    "@types/react": "19.2.7",
    "@types/react-dom": "19.2.3",
    "@vitejs/plugin-react": "5.1.2",
    "eslint": "9.39.2",
    "eslint-config-next": "16.2.9",
    "jsdom": "27.3.0",
    "typescript": "5.9.3",
    "vitest": "4.0.18"
  }
}
